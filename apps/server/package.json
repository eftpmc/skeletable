{
  "name": "@closet/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "search:eval": "tsx --env-file-if-exists=../../.env scripts/search-eval.ts",
    "catalog:import": "tsx src/catalog/import-cli.ts"
  },
  "dependencies": {
    "@closet/db": "workspace:*",
    "@closet/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "meilisearch": "0.62.0",
    "node-html-parser": "^9.0.5",
    "nodemailer": "^7.0.13",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "@closet/readers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.12",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
