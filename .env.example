# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skeleton
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL the app is reached at (used for auth cookies and redirects).
PUBLIC_URL=http://localhost:5173
PORT=3000
# cloud | selfhost
DEPLOYMENT=selfhost
# Anyone can sign up (the first account always can). Defaults to true for cloud, false for selfhost.
SIGNUPS_ENABLED=true
# Signed-out visitors can search. Defaults to true for cloud, false for selfhost.
# PUBLIC_SEARCH=true
# Where uploaded files are stored.
DATA_DIR=./data
# true when behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Let link import fetch private network addresses (off by default for safety).
ALLOW_PRIVATE_FETCH=false
# Meilisearch, for searching the catalog. Run one locally:
#   docker run -d -p 7700:7700 -e MEILI_MASTER_KEY=dev-master-key-0123456789 getmeili/meilisearch:v1.56.0
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-0123456789
# Search sources (all optional). See README.
SHOPIFY_STORES=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
BESTBUY_API_KEY=
# Optional experiment. Off until real-query evaluation justifies enabling it.
SEARCH_INTENT_ENABLED=false
OPENAI_API_KEY=
SEARCH_INTENT_MODEL=gpt-5.6-luna
# Per-process, in-memory daily call limit (resets on restart), not a billing cap.
SEARCH_INTENT_DAILY_LIMIT=1000
# Where store logos come from when a store's site has none we can read: google or none.
STORE_ICON_FALLBACK=google
# How often saved searches re-run and tracked prices are checked, in minutes (0 turns it off).
ALERTS_INTERVAL_MINUTES=360
# Morning alert digest by email (optional). Set EMAIL_FROM and either SMTP_URL or RESEND_API_KEY.
# Railway blocks outbound SMTP on some plans; Resend sends over HTTPS.
EMAIL_FROM=
SMTP_URL=
RESEND_API_KEY=
# Local hour the digest goes out, in each person's time zone.
DIGEST_HOUR=8
